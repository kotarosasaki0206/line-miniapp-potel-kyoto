{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "umekoji-potel-guest-demo",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "build": {
    "command": "npm run build"
  }
}
